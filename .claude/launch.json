{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "FastAPI (agecob-lens API)",
      "runtimeExecutable": "python",
      "runtimeArgs": ["main.py"],
      "port": 8000
    },
    {
      "name": "Vite (agecob-lens frontend)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "agecob-lens",
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "Vite (proxy producao)",
      "runtimeExecutable": "C:\\Windows\\System32\\cmd.exe",
      "runtimeArgs": ["/c", "set VITE_API_PROXY_TARGET=http://192.168.0.20:8000&& npm run dev"],
      "cwd": "agecob-lens",
      "port": 5173,
      "autoPort": true
    }
  ]
}
