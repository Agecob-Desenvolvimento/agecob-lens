{"nodes": [{"id": "agecob_decisoes_tecnicas", "label": "Agecob Decis\u00f5es T\u00e9cnicas (ADRs)", "file_type": "document", "source_file": "agecob-lens/docs/complementa\u00e7\u00e3o e centraliza\u00e7\u00e3o/agecob-decisoes-tecnicas.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "adr_001_monolito", "label": "ADR-001: Monolito em main.py", "file_type": "rationale", "source_file": "agecob-lens/docs/complementa\u00e7\u00e3o e centraliza\u00e7\u00e3o/agecob-decisoes-tecnicas.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": "rationale: keep monolith until refactor is validated in production; single source of truth for queries facilitates audits and diffs; split deferred to separate PR"}, {"id": "adr_002_ctes_separadas", "label": "ADR-002: CTEs Separadas \u2014 Join de Agregados", "file_type": "rationale", "source_file": "agecob-lens/docs/complementa\u00e7\u00e3o e centraliza\u00e7\u00e3o/agecob-decisoes-tecnicas.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": "rationale: direct join between CTO_MASTER and REC_MASTER caused implicit cartesian product (81s for 6 months); separating aggregations into CTEs then joining aggregates dropped to ~1s \u2014 mandatory pattern for all future historical queries"}, {"id": "adr_003_fato_sem_agente", "label": "ADR-003: Tabela Fato sem Dimens\u00e3o Agente (Fase 1)", "file_type": "rationale", "source_file": "agecob-lens/docs/complementa\u00e7\u00e3o e centraliza\u00e7\u00e3o/agecob-decisoes-tecnicas.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": "rationale: grain day\u00d7portfolio\u00d7bank avoids expensive CTO_MASTER join in phase 1, enabling fast delivery; agent-level grain deferred to separate fato_produtividade_agente table in a future phase"}, {"id": "adr_004_cross_apply", "label": "ADR-004: CROSS APPLY TOP 1 para Portf\u00f3lio", "file_type": "rationale", "source_file": "agecob-lens/docs/complementa\u00e7\u00e3o e centraliza\u00e7\u00e3o/agecob-decisoes-tecnicas.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": "rationale: an agreement covering multiple debts causes row multiplication on direct JOIN with DIV_AUX; CROSS APPLY TOP 1 guarantees exactly one portfolio row per agreement"}, {"id": "adr_005_filtro_sql", "label": "ADR-005: Filtro de Agentes Exclusivamente no SQL", "file_type": "rationale", "source_file": "agecob-lens/docs/complementa\u00e7\u00e3o e centraliza\u00e7\u00e3o/agecob-decisoes-tecnicas.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": "rationale: dual filtering (SQL + Python) was redundant; removing Python filter eliminates extra resultset iteration and centralizes debug to SQL only"}, {"id": "adr_006_cpc_hardcoded", "label": "ADR-006: CPC IDs Hardcoded", "file_type": "rationale", "source_file": "agecob-lens/docs/complementa\u00e7\u00e3o e centraliza\u00e7\u00e3o/agecob-decisoes-tecnicas.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": "rationale: change frequency does not justify dynamic config complexity; manual management by data scientist (Isaque) provides adequate control with simpler implementation"}, {"id": "adr_007_cross_db_entities", "label": "ADR-007: Agente Cross-Database como Entidades Separadas", "file_type": "rationale", "source_file": "agecob-lens/docs/complementa\u00e7\u00e3o e centraliza\u00e7\u00e3o/agecob-decisoes-tecnicas.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": "rationale: default separate-entity model keeps standard views clean; explicit consolidation via normalized CHAVE available only in /produtividade-agentes endpoint for cross-DB comparison"}, {"id": "adr_008_prompts_ingles", "label": "ADR-008: Prompts de Agente em Ingl\u00eas", "file_type": "rationale", "source_file": "agecob-lens/docs/complementa\u00e7\u00e3o e centraliza\u00e7\u00e3o/agecob-decisoes-tecnicas.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": "rationale: Claude Code agents perform better with English prompts; internal decision docs and diary remain in Portuguese"}, {"id": "adr_009_add_only", "label": "ADR-009: ADD-ONLY Discipline for Implementation Prompts", "file_type": "rationale", "source_file": "agecob-lens/docs/complementa\u00e7\u00e3o e centraliza\u00e7\u00e3o/agecob-decisoes-tecnicas.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": "rationale: in solo environment without code review, mixing additions with refactors risks undetected regressions; separate prompts for each concern enables isolated verification"}, {"id": "adr_010_yaml_rules", "label": "ADR-010: Regras Prescritivas em YAML Externalizado", "file_type": "rationale", "source_file": "agecob-lens/docs/complementa\u00e7\u00e3o e centraliza\u00e7\u00e3o/agecob-decisoes-tecnicas.md", "source_location": "backend/rules/operacional.yaml", "source_url": null, "captured_at": null, "author": null, "contributor": "rationale: business team needs to adjust thresholds without deployments; YAML with versioned schema + admin reload endpoint decouples rule tuning from code changes"}, {"id": "adr_011_freshness_metadata", "label": "ADR-011: Freshness Metadata no Envelope de Resposta", "file_type": "rationale", "source_file": "agecob-lens/docs/complementa\u00e7\u00e3o e centraliza\u00e7\u00e3o/agecob-decisoes-tecnicas.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": "rationale: fact table endpoints may return stale data if aggregation job did not run; freshness_status + last_aggregation_at in meta enables frontend to warn users of stale data"}, {"id": "fato_produtividade_portfolio", "label": "fato_produtividade_portfolio \u2014 Fact Table (day \u00d7 portfolio \u00d7 bank)", "file_type": "rationale", "source_file": "agecob-lens/docs/complementa\u00e7\u00e3o e centraliza\u00e7\u00e3o/agecob-decisoes-tecnicas.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": "rationale: daily aggregation job populates fact table to avoid live 12-month range queries against transactional tables; grain excludes agent dimension in phase 1 for fast delivery"}], "edges": [{"source": "agecob_decisoes_tecnicas", "target": "adr_001_monolito", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agecob-lens/docs/complementa\u00e7\u00e3o e centraliza\u00e7\u00e3o/agecob-decisoes-tecnicas.md", "source_location": "ADR-001", "weight": 1.0}, {"source": "agecob_decisoes_tecnicas", "target": "adr_002_ctes_separadas", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agecob-lens/docs/complementa\u00e7\u00e3o e centraliza\u00e7\u00e3o/agecob-decisoes-tecnicas.md", "source_location": "ADR-002", "weight": 1.0}, {"source": "agecob_decisoes_tecnicas", "target": "adr_003_fato_sem_agente", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agecob-lens/docs/complementa\u00e7\u00e3o e centraliza\u00e7\u00e3o/agecob-decisoes-tecnicas.md", "source_location": "ADR-003", "weight": 1.0}, {"source": "agecob_decisoes_tecnicas", "target": "adr_004_cross_apply", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agecob-lens/docs/complementa\u00e7\u00e3o e centraliza\u00e7\u00e3o/agecob-decisoes-tecnicas.md", "source_location": "ADR-004", "weight": 1.0}, {"source": "agecob_decisoes_tecnicas", "target": "adr_005_filtro_sql", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agecob-lens/docs/complementa\u00e7\u00e3o e centraliza\u00e7\u00e3o/agecob-decis