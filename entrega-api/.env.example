# ─────────────────────────────────────────────────────────────────
# Template — copy to .env.local / .env.dev / .env.production
# Never commit real secrets.
# ─────────────────────────────────────────────────────────────────

# Which environment: local | dev | production
APP_ENV=local

# Database (SQL Server)
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_SERVER=your_db_server_ip
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Auth (leave false for local dev)
API_KEY=your_api_key
API_TOKEN=your_api_token
REQUIRE_API_AUTH=false

# CORS — comma-separated origins
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Feature flags
ENABLE_AGENT_TELEMETRY=false
ENABLE_VALIDATED_ROUTES=true
ENABLE_INDEX_ADMIN=false

# Sentry (erros + performance) — vazio desliga
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
