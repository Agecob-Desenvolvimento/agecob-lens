# Frontend env template — copy to .env.local / .env.dev / .env.production
# Production deploy (LAN): VITE_API_BASE_URL=https://dashboard.local
# NÃO existe VITE_API_KEY/VITE_API_TOKEN: qualquer valor aqui vaza no bundle JS
# público. A auth é injetada pelo proxy Caddy no upstream (ver infra/Caddyfile).
VITE_API_BASE_URL=http://localhost:8000
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
VITE_ENABLE_ANALYTICS=false
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
# Sentry (erros + performance) — vazio desliga. DSN publico, ok expor no bundle.
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
