DB_DRIVER=ODBC Driver 17 for SQL Server
DB_SERVER=SEU_HOST_SQL_SERVER
DB_USER=SEU_USUARIO_SQL
DB_PASSWORD=SUA_SENHA_SQL

API_KEY=SUA_API_KEY
API_TOKEN=SEU_API_TOKEN
REQUIRE_API_AUTH=false
ENABLE_AGENT_TELEMETRY=false

# Admin de indices SQL (endpoints /admin/indexes/*). Mantenha false por padrao.
# Somente ative em janela de manutencao controlada por DBA.
ENABLE_INDEX_ADMIN=false
